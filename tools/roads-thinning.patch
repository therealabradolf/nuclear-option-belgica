+def dense_pieces(build, A, P, threshold):
+    """Pieces whose midpoint lies in a TOWN_CELL cell holding at least `threshold` buildings."""
+    path = build / "buildings.npz"
+    if not path.exists():
+        return np.zeros(len(P["u"]), bool)
+    d = np.load(path)
+    x, z = d["x"].astype(np.float64), d["z"].astype(np.float64)
+
+    def key(xx, zz):
+        return np.floor(xx / TOWN_CELL).astype(np.int64) * 1000003 + np.floor(zz / TOWN_CELL).astype(np.int64)
+    k, c = np.unique(key(x, z), return_counts=True)
+    mx = (A["nx"][P["u"]] + A["nx"][P["v"]]) / 2
+    mz = (A["nz"][P["u"]] + A["nz"][P["v"]]) / 2
+    return np.isin(key(mx, mz), k[c >= threshold])
+
+
